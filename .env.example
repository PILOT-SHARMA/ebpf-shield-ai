# ──────────────────────────────────────────────────────────────
# ContainerShield AI — Example Environment Configuration
# Copy this file to .env and adjust values as needed for your environment:
#   cp .env.example .env
# ──────────────────────────────────────────────────────────────

# ── PostgreSQL Database ──
POSTGRES_USER=ebpf_shield
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=ebpf_shield
DATABASE_URL=postgresql://ebpf_shield:your_secure_password_here@postgres:5432/ebpf_shield

# ── FastAPI Backend ──
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=*

# ── Telemetry Collector ──
# Options: replay (default, recommended for macOS/Docker)
COLLECTOR_MODE=replay
COLLECTOR_INTERVAL=5
BACKEND_URL=http://backend:8000

# ── Frontend Reverse Proxy ──
FRONTEND_PORT=3000
