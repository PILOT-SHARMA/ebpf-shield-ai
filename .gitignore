ipython_config.py

# ── Environments ──
.venv
venv/
env/
ENV/
env.bak/
venv.bak/

# ── pipenv / uv / poetry / pdm / pixi ──
.pdm-python
.pdm-build/
.pixi
__pypackages__/

# ── Celery stuff ──
celerybeat-schedule
celerybeat.pid

# ── Redis ──
*.rdb
*.aof
*.pid

# ── RabbitMQ / ActiveMQ ──
mnesia/
rabbitmq/
rabbitmq-data/
activemq-data/

# ── SageMath parsed files ──
*.sage.py

# ── Spyder / Rope project settings ──
.spyderproject
.spyproject
.ropeproject

# ── mkdocs ──
/site

# ── Type checkers ──
